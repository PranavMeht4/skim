+  assert.equal(dueAfterCreate(330, '2026-02-28T22:00:00Z'), 0); // old bug fired here
+  assert.equal(dueAfterCreate(330, '2026-03-01T03:29:00Z'), 0);
+  assert.equal(dueAfterCreate(330, '2026-03-01T03:30:00Z'), 1);
