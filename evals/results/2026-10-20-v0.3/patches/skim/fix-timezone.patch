+// Regression: the scheduler used to apply tz_offset_min to due_ms a second time,
+// so IST users (330) got reminders 5.5h early and US users got them late.
+// Goes through the real create path so the api/scheduler contract is covered.
+const dueAfterCreate = (tzOffsetMin, nowIso) => {
+  reset();
+  handle({ method: 'POST', path: '/reminders', body: { userId: 'u1', text: 'x', at: '2026-03-01T09:00', tzOffsetMin } });
+  return dueReminders(query('SELECT * FROM reminders WHERE sent = 0'), at(nowIso)).length;
+};
