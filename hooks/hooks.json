{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; SKIM_DATA_DIR=\"${CLAUDE_PLUGIN_DATA}\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
